// SPDX-License-Identifier: GPL-3.0-or-later
//
// LCAD's icon, and what Windows shows in the program's properties. CMake fills in the version.

#include <winver.h>

IDI_ICON1 ICON "@LCAD_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LCAD contributors"
            VALUE "FileDescription", "LCAD"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "lcad"
            VALUE "LegalCopyright", "GNU General Public License, version 3 or later"
            VALUE "OriginalFilename", "lcad.exe"
            VALUE "ProductName", "LCAD"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
